# Installatiescripts van pakketten niet uitvoeren (W-SEC-21). Besmette
# npm-pakketten voeren hun kwaadaardige code meestal uit via zo'n script.
# Geen enkel pakket van deze site heeft een installatiescript nodig.
# "npm run build" en andere eigen scripts werken gewoon.
ignore-scripts=true

# Nieuwe versies van pakketten pas na 7 dagen gebruiken (W-SEC-21), zoals
# Dependabot. Werkt vanaf npm 11.10; oudere npm-versies slaan dit over.
min-release-age=7
